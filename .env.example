# Smart Campus environment variables
# Secrets should come from secretsbank -> ~/.htdi/secrets.sh -> exported into the shell.

# Home Assistant integration (required)
HA_BASE_URL=https://your-home-assistant-url
HA_ACCESS_TOKEN=your_long_lived_token

# Frontend build-time mirrors (optional; only if the Vite build needs them)
# VITE_HA_BASE_URL=https://your-home-assistant-url
# VITE_HA_TOKEN=your_long_lived_token

# Tier 2 Orchestrator Integration
TIER2_CHAT_BASE_URL=http://localhost:8081/api
